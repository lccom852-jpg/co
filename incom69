function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
      .setTitle('ระบบบัญชีรายรับ - รายจ่ายส่วนบุคคล')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no');
}

// ------------------------------------------------------------------
// 1. ระบบจัดการและสร้าง Sheet อัตโนมัติ
// ------------------------------------------------------------------
function getSheet(sheetName) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(sheetName);
  
  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
    if (sheetName === 'Users') {
      var headers = ['User_ID', 'Username', 'Password', 'Created_At'];
      sheet.appendRow(headers);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#f3f4f6');
    } else if (sheetName === 'Transactions') {
      var headers = ['ID', 'User_ID', 'ประเภท', 'วันที่', 'รายการ', 'จำนวนเงิน', 'เวลาบันทึก'];
      sheet.appendRow(headers);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#f3f4f6');
    }
  }
  return sheet;
}

// ------------------------------------------------------------------
// 2. ระบบ สมัครสมาชิก & เข้าสู่ระบบ (Auth)
// ------------------------------------------------------------------
function registerUser(username, password) {
  var sheet = getSheet('Users');
  var data = sheet.getDataRange().getValues();
  
  // ตรวจสอบชื่อผู้ใช้ซ้ำ
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][1]).toLowerCase() === username.toLowerCase()) {
      return { success: false, message: 'ชื่อผู้ใช้นี้ถูกใช้งานแล้ว' };
    }
  }
  
  var userId = 'USR_' + Date.now();
  var timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
  
  sheet.appendRow(["'" + userId, username, password, timestamp]);
  return { success: true, message: 'สมัครสมาชิกสำเร็จ! กรุณาเข้าสู่ระบบ' };
}

function loginUser(username, password) {
  var sheet = getSheet('Users');
  var data = sheet.getDataRange().getValues();
  
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][1]).toLowerCase() === username.toLowerCase() && String(data[i][2]) === String(password)) {
      return {
        success: true,
        user: { userId: String(data[i][0]), username: String(data[i][1]) }
      };
    }
  }
  return { success: false, message: 'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง' };
}

// ------------------------------------------------------------------
// 3. ระบบจัดการข้อมูล (ดึง / เพิ่ม / ลบ) แยกตาม User ID
// ------------------------------------------------------------------
function getDashboardData(userId) {
  var sheet = getSheet('Transactions');
  var data = sheet.getDataRange().getValues();
  
  var incomeList = [];
  var expenseList = [];
  
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    // กรองเฉพาะข้อมูลของ User ที่เข้าสู่ระบบอยู่
    if (String(row[1]) === String(userId)) {
      var dateVal = row[3];
      if (dateVal instanceof Date) {
        dateVal = Utilities.formatDate(dateVal, Session.getScriptTimeZone(), "dd/MM/yyyy");
      }
      
      var item = {
        id: String(row[0]),
        type: String(row[2]),
        date: String(dateVal),
        title: String(row[4]),
        amount: Number(row[5])
      };
      
      if (item.type === 'รายรับ') incomeList.push(item);
      else if (item.type === 'รายจ่าย') expenseList.push(item);
    }
  }
  
  return {
    incomeData: incomeList.reverse(),
    expenseData: expenseList.reverse()
  };
}

function addTransaction(data) {
  var sheet = getSheet('Transactions');
  var id = String(data.id || Date.now());
  var formattedTimestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm:ss");
  
  sheet.appendRow([
    "'" + id,
    "'" + data.userId,
    data.type,
    data.date,
    data.title,
    Number(data.amount),
    formattedTimestamp
  ]);
  
  return { success: true, id: id };
}

function deleteTransaction(id, userId) {
  var sheet = getSheet('Transactions');
  var data = sheet.getDataRange().getValues();
  var targetId = String(id);
  var targetUser = String(userId);
  
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === targetId && String(data[i][1]) === targetUser) {
      sheet.deleteRow(i + 1);
      break;
    }
  }
  return { success: true };
}
